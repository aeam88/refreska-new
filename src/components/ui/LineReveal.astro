---
// Línea de texto con máscara para reveal (GSAP anima el span interno)
// Uso: <LineReveal>Texto <em class="grad-text">con acento</em></LineReveal>
interface Props {
  as?: 'h1' | 'h2' | 'h3' | 'p' | 'span' | 'div';
  class?: string;
}
const { as: Tag = 'h2', class: className = '' } = Astro.props;
---

<Tag class:list={['line', className]}><span><slot /></span></Tag>
