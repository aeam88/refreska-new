---
interface Props {
  as?: 'p' | 'span' | 'div';
  class?: string;
}
const { as: Tag = 'p', class: className = '' } = Astro.props;
---

<Tag class:list={['eyebrow', className]}>
  <span class="eyebrow-line" aria-hidden="true"></span>
  <slot />
</Tag>

<style>
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--c1);
    font-weight: 500;
  }

  .eyebrow-line {
    width: 34px;
    height: 1px;
    background: currentColor;
    flex-shrink: 0;
  }
</style>
